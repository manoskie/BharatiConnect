rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isActiveUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function validUserBook() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.author is string
        && request.resource.data.totalPages is int
        && request.resource.data.totalPages > 0
        && request.resource.data.currentPage is int
        && request.resource.data.currentPage >= 0
        && request.resource.data.currentPage <= request.resource.data.totalPages
        && request.resource.data.status in ['want_to_read', 'reading', 'finished'];
    }

    function validCatalogBook() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.totalPages is int
        && request.resource.data.totalPages > 0
        && request.resource.data.language in ['en', 'mr', 'hi']
        && request.resource.data.coverUrl is string
        && request.resource.data.staffPick is bool
        && request.resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role == 'admin'
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.active == true;
      allow update, delete: if isOwner();
    }

    match /users/{userId} {
      // Allow all logged-in staff members to read user profiles (needed for Leaderboard)
      allow read: if request.auth != null;

      // Account invitations create the profile and matching admin record atomically.
      allow create: if isAdmin()
        && request.resource.data.id == userId
        && request.resource.data.active == true
        && (
          request.resource.data.role == 'staff'
          || (isOwner()
            && request.resource.data.role == 'admin'
            && existsAfter(/databases/$(database)/documents/admins/$(userId))
            && getAfter(/databases/$(database)/documents/admins/$(userId)).data.role == 'admin')
        );

      // Allow users to update their own profile, and administrators to manage staff points/status.
      allow update: if (request.auth != null && request.auth.uid == userId)
        || (isAdmin()
          && resource.data.role == 'staff'
          && request.resource.data.role == 'staff'
          && (
            (request.resource.data.points == 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']))
            || (request.resource.data.active is bool
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']))
            || (request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.phone is string
              && request.resource.data.departmentId is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'phone', 'departmentId'
              ]))
          ))
        || (isOwner()
          && resource.data.role == 'admin'
          && request.resource.data.role == 'admin'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.departmentId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'departmentId'
          ]))
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['staff', 'admin']
          && (
            (request.resource.data.role == 'admin'
              && existsAfter(/databases/$(database)/documents/admins/$(userId))
              && getAfter(/databases/$(database)/documents/admins/$(userId)).data.role == 'admin')
            || (request.resource.data.role == 'staff'
              && !existsAfter(/databases/$(database)/documents/admins/$(userId)))
          ))
        || (isOwner()
          && resource.data.role == 'admin'
          && request.resource.data.role == 'admin'
          && request.resource.data.active == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && !existsAfter(/databases/$(database)/documents/admins/$(userId)));
    }

    match /departments/{departmentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() && validCatalogBook();
      allow update: if isAdmin()
        && validCatalogBook()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /userBooks/{userBookId} {
      allow read: if isActiveUser()
        && (userBookId.matches('^' + request.auth.uid + '_.*$')
          || resource.data.userId == request.auth.uid
          || isAdmin());
      allow create: if isActiveUser()
        && userBookId == request.auth.uid + '_' + request.resource.data.id
        && validUserBook();
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && userBookId == request.auth.uid + '_' + request.resource.data.id
        && validUserBook()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title == resource.data.title
        && request.resource.data.author == resource.data.author
        && request.resource.data.totalPages == resource.data.totalPages;
      allow delete: if isActiveUser()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reading_logs/{logId} {
  allow read: if request.auth != null
    && (resource.data.userId == request.auth.uid || isAdmin());
  allow write: if request.auth != null && logId.matches(request.auth.uid + '.*');
}

    match /challenges/{challengeId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /takeaways/{takeawayId} {
      allow read: if isActiveUser()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if isAdmin();
    }

    match /userActivity/{userId} {
      allow read: if isActiveUser() && request.auth.uid == userId;
      allow create: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'readNoticeIds', 'watchedVideoIds', 'joinedChallengeIds'
        ])
        && (!('readNoticeIds' in request.resource.data) || request.resource.data.readNoticeIds is list)
        && (!('watchedVideoIds' in request.resource.data) || request.resource.data.watchedVideoIds is list)
        && (!('joinedChallengeIds' in request.resource.data) || request.resource.data.joinedChallengeIds is list);
      allow update: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readNoticeIds', 'watchedVideoIds', 'joinedChallengeIds'
        ])
        && (!('readNoticeIds' in request.resource.data) || request.resource.data.readNoticeIds is list)
        && (!('watchedVideoIds' in request.resource.data) || request.resource.data.watchedVideoIds is list)
        && (!('joinedChallengeIds' in request.resource.data) || request.resource.data.joinedChallengeIds is list);
      allow delete: if isOwner();
    }

    match /auditLogs/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
